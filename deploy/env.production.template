# ============================================================
# PRODUCTION ENVIRONMENT — copy to /opt/greggory-app/.env and fill in.
# Every value below MUST be replaced before go-live.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ============================================================

NODE_ENV=production
PORT=3000

# ── Database (MySQL runs on this same VM) ──
DB_HOST=localhost
DB_USER=greggory_app
DB_PASSWORD=<the-mysql-password-you-set-in-setup-script>
DB_NAME=the_greggory_systems_and_strategy_firm_db_main

# ── Auth secrets (GENERATE FRESH — never reuse dev values) ──
JWT_SECRET=<paste-generated-secret>
JWT_EXPIRES_IN=7d
ADMIN_SESSION_SECRET=<paste-generated-secret>
SESSION_SECRET=<paste-generated-secret>
ADMIN_KEY=<generate-a-long-random-admin-api-key>

# Second factor for admin signup/login (share only with admins)
ADMIN_CODE=<choose-a-strong-admin-code>

# ── Networking / CORS ──
# Your Netlify site URL (exact origin, no trailing slash) — whitelisted by CORS
FRONTEND_URL=https://<your-site>.netlify.app
# Public base URL of THIS server (used to build email links etc.)
BACKEND_URL=https://api.<your-domain>.co.ke

# ── M-Pesa Daraja ──
MPESA_CONSUMER_KEY=<from-daraja-app>
MPESA_CONSUMER_SECRET=<from-daraja-app>
MPESA_PASSKEY=<production-passkey-emailed-after-go-live>
MPESA_SHORTCODE=<your-paybill-or-till>
MPESA_CALLBACK_URL=https://api.<your-domain>.co.ke/api/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# ── Email (Gmail App Password recommended) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Greggory Firm <your-email@gmail.com>"
SMTP_TO=

# ── SMS / WhatsApp (optional until configured) ──
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# ── Company contact ──
COMPANY_PHONE_NUMBER=0115 525854
COMPANY_WHATSAPP_NUMBER=0115 525854

# ── Rate limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
