# =============================================================
# The Greggory Systems & Strategy Firm — .env.example
# Copy to .env and fill in your values.
# Lines marked "OPTIONAL" can be left empty.
# =============================================================

# ── Required: Auth secrets (use long random strings in production) ──
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_SESSION_SECRET=
SESSION_SECRET=

# ── Admin panel access ──
ADMIN_KEY=
ADMIN_CODE=

# ── Database Configuration ──
# Primary (cloud, e.g. Aiven) MySQL
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=the_greggory_systems_and_strategy_firm_db_main
DB_SSL=

# Local backup (XAMPP) MySQL
DB_HOST_2=127.0.0.1
DB_PORT_2=3306
DB_USER_2=root
DB_PASSWORD_2=
DB_NAME_2=the_greggory_systems_and_strategy_firm_db_main
DB_SSL_2=false

# ── App Configuration ──
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Optional: Redis (rate limiting + sessions) ──
# If REDIS_URL is unset, the server gracefully falls back to in-memory
# rate-limit and session storage. This is intentional for free-tier
# deployments (Render). For production with multiple dynos, set a Redis URL.
# REDIS_URL=

# ── Optional: MongoDB ──
# If MONGODB_URI is unset, MongoDB is skipped entirely (MySQL only).
# MONGODB_URI=

# ── Optional: Google Auth ("Sign in with Google") ──
# OAuth 2.0 client id (type: Web application) — the SAME value in both lines.
# Authorized JavaScript origins: http://localhost:5173 + the live site URL.
# Setup guide: GOOGLE_SIGNIN_SETUP.md (empty = the Google button is hidden)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ── Optional: Google Cloud Storage ──
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
STORAGE_BUCKET_MEDIA=
STORAGE_BUCKET_BACKUPS=

# ── Optional: SMTP (email) ──
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# ── Optional: Africa's Talking (SMS) ──
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
COMPANY_PHONE_NUMBER=
COMPANY_WHATSAPP_NUMBER=

# ── Optional: M-Pesa Daraja API ──
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=