# ============================================================
# Frontend (Vite) — baked into the bundle at BUILD time
# ============================================================
# Local dev: leave unset -> defaults to '/api' (Vite proxy -> localhost:3000)
# Production: full backend origin INCLUDING /api, e.g.
#   VITE_API_BASE_URL=https://api.your-domain.com/api
# VITE_API_BASE_URL=/api

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-service-account.json

# Storage Buckets
STORAGE_BUCKET_MEDIA=gregory-foundation-media
STORAGE_BUCKET_BACKUPS=gregory-foundation-backups

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=the_greggory_systems_and_strategy_firm_db

# App Configuration
NODE_ENV=development
PORT=3000

# JWT Secret (for authentication)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Signs admin panel session tokens (use a long random string in production)
ADMIN_SESSION_SECRET=your_long_random_admin_session_secret

# Second factor for admin panel login and Admin/Developer signup — set in .env only; do not put real values in git
# Prefer ADMIN_CODE. Legacy name ADMIN_ACCESS_CODE is still read if ADMIN_CODE is empty.
# ADMIN_CODE=<generate-a-strong-code>
ADMIN_CODE=

# Email Configuration (if needed)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM="Gregory Foundation <noreply@gregoryfoundation.com>"

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Session Secret (for express-session)
SESSION_SECRET=your_session_secret_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15*60*1000  // 15 minutes
RATE_LIMIT_MAX=100  // limit each IP to 100 requests per windowMs

# Africa's Talking SMS Configuration
AFRICASTALKING_USERNAME=your_africastalking_username
AFRICASTALKING_API_KEY=your_africastalking_api_key

# Company Phone Number (receives messages from users/clients)
COMPANY_PHONE_NUMBER=+254715312251
COMPANY_WHATSAPP_NUMBER=+254715312251

# M-Pesa Daraja API Configuration
# Create a free app at https://developer.safaricom.co.ke ("Lipa Na M-Pesa Online")
# to get CONSUMER_KEY/SECRET. Passkey below is Safaricom's PUBLIC SANDBOX passkey.
# For live payments: Go-Live approval -> swap passkey + use your Paybill/Till shortcode,
# set NODE_ENV=production, and point MPESA_CALLBACK_URL at your public backend.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=http://localhost:3000/api/mpesa/callback
