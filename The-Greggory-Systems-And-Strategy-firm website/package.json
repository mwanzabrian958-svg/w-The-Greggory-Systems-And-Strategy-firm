{
  "name": "greggory-systems-strategy-firm",
  "version": "1.0.0",
  "description": "The-Greggory-Systems-And-Strategy-firm - Strategic Systems and Business Solutions",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"XAMPP,WORKSPACE,BACKEND,FRONTEND\" -c \"magenta,cyan,blue,green\" \"npm run start:xampp\" \"npm run open:workspace\" \"npm run server\" \"vite\"",
    "dev:simple": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run server\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "nodemon server.js",
    "server:legacy": "echo 'Legacy server disabled. Use root server.js'",
    "start:xampp": "powershell -ExecutionPolicy Bypass -File scripts/start-xampp.ps1",
    "start:xampp:js": "node scripts/start-xampp-services.js",
    "open:phpmyadmin": "node scripts/open-phpmyadmin.js",
    "open:workspace": "node scripts/dev-open.js",
    "build": "vite build",
    "preview": "vite preview",
    "db:init": "node scripts/initialize-db.js",
    "backup:cloud-to-local": "node scripts/backup-cloud-to-local.js",
    "backup:schedule": "node scripts/setup-backup-schedule.js",
    "db:whatsapp": "node scripts/setup-whatsapp-verification.js",
    "start": "node server.js",
    "start:cloud": "node scripts/import-if-empty.js && node server.js",
    "server": "nodemon server.js"
  },
  "nodemonConfig": {
    "watch": ["server.js"],
    "ignore": ["backups/*", "dist/*", "scripts/*", "docs/*", "database/*", "uploads/*"]
  },
  "dependencies": {
    "@google-cloud/storage": "^5.18.3",
    "@headlessui/react": "^2.2.10",
    "@react-oauth/google": "^0.12.2",
    "@tailwindcss/typography": "^0.5.20",
    "africastalking": "^0.7.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "daisyui": "^4.12.24",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.284.0",
    "mongoose": "^8.24.4",
    "multer": "^2.1.1",
    "mysql2": "^3.15.3",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "redis": "^6.2.1",
    "uuid": "^13.0.0"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.1.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.3",
    "postcss": "^8.4.31",
    "puppeteer-core": "^25.8.0",
    "tailwindcss": "^3.3.3",
    "vite": "^7.2.2"
  }
}
